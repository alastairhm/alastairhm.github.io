jpg"&#10;width="800" height="600"&#10;alt="Inktober 2024"&gt;&#10;&lt;/a&gt;&lt;script async src="//embedr.flickr.com/assets/client-code.js" charset="utf-8"&gt;&lt;/script&gt;</description></item><item><title>Inktober 2022 Album</title><link>https://blog.0x32.co.uk/posts/inktober2022album/</link><pubDate>Wed, 04 Jan 2023 13:40:09 +0000</pubDate><guid>https://blog.0x32.co.uk/posts/inktober2022album/</guid><description>&lt;p&gt;Flickr Album for Inktober 2022&lt;/p&gt;&#10;&lt;a data-flickr-embed="true" data-header="true" data-footer="true"&#10;href="https://www.flickr.com/photos/doodle_m/albums/72177720302594814"&#10;title="Inktober 2022"&gt;&#10;&lt;img src="https://live.staticflickr.com/65535/52399850791_76d970d8b3.jpg"&#10;width="800" height="600"&#10;alt="Inktober 2022"&gt;&#10;&lt;/a&gt;&lt;script async src="//embedr.flickr.com/assets/client-code.js" charset="utf-8"&gt;&lt;/script&gt;</description></item><item><title>Photo Leeds Morning Walk</title><link>https://blog.0x32.co.uk/posts/photo-leeds/</link><pubDate>Sat, 01 Oct 2022 11:06:10 +0100</pubDate><guid>https://blog.0x32.co.uk/posts/photo-leeds/</guid><description>&lt;p&gt;Walk to the office last Thursday morning in Leeds.&lt;/p&gt;&#10;&lt;figure class="wp-caption alignnone"&gt;&#10; &lt;a data-flickr-embed="true" data-header="true" data-footer="false"&#10; data-context="false"&#10; href="https://www.flickr.com/photos/doodle_m/52394752819"&#10; title="Leeds"&gt;&#10; &lt;img src="https://live.staticflickr.com/65535/52394752819_c1e406d655_c.jpg" width="800" alt="Leeds" /&gt;&#10; &lt;/a&gt;&lt;script async src="//embedr.flickr.com/assets/client-code.js" charset="utf-8"&gt;&lt;/script&gt;&#10; &lt;figcaption class="wp-caption-text"&gt;Leeds Morning Walk&lt;/figcaption&gt;&#10; &lt;/figure&gt;</description></item><item><title>Seaham 2022, Flickr Album</title><link>https://blog.0x32.co.uk/posts/seaham2022/</link><pubDate>Sun, 03 Jul 2022 17:17:51 +0100</pubDate><guid>https://blog.0x32.co.uk/posts/seaham2022/</guid><description>&lt;p&gt;Flickr Album from Weekend break to Seaham in County Durham, England.&lt;/p&gt;&#10;&lt;a data-flickr-embed="true" data-header="true" data-footer="true"&#10;href="https://www.flickr.com/photos/doodle_m/albums/72177720300238588"&#10;title="Seaham 2020"&gt;&#10;&lt;img src="https://live.staticflickr.com/65535/52174173113_abaaabd086.jpg"&#10;width="800" height="600"&#10;alt="Seaham 2020"&gt;&#10;&lt;/a&gt;&lt;script async src="//embedr.flickr.com/assets/client-code.js" charset="utf-8"&gt;&lt;/script&gt;</description></item><item><title>Flickr favs</title><link>https://blog.0x32.co.uk/posts/flickfavs/</link><pubDate>Tue, 20 Oct 2020 10:33:19 +0100</pubDate><guid>https://blog.0x32.co.uk/posts/flickfavs/</guid><description>&lt;p&gt;My picture on Flickr which have been liked by four or more people.&lt;/p&gt;&#10;&lt;a data-flickr-embed="true" data-header="true" data-footer="true"&#10;href="https://www.flickr.com/photos/doodle_m/albums/72157716518634228"&#10;title="Flickr Favs"&gt;&#10;&lt;img src="https://live.staticflickr.com/2373/2241115697_e93f8f523a_c.jpg"&#10;width="800" height="600"&#10;alt="Flickr Favs"&gt;&#10;&lt;/a&gt;&lt;script async src="//embedr.flickr.com/assets/client-code.js" charset="utf-8"&gt;&lt;/script&gt;</description></item><item><title>Flickr album Short Code</title><link>https://blog.0x32.co.uk/posts/flickalbum/</link><pubDate>Tue, 13 Oct 2020 09:28:23 +0100</pubDate><guid>https://blog.0x32.co.uk/posts/flickalbum/</guid><description>&lt;p&gt;Short code for embedding Flickr albums easily.&#10;Here demonstrated with my Inkotober 2020 album.&lt;/p&gt;&#10;&lt;a data-flickr-embed="true" data-header="true" data-footer="true"&#10;href="https://www.flickr.com/photos/doodle_m/albums/72157716205953681"&#10;title="Inktober 2020"&gt;&#10;&lt;img src="https://live.staticflickr.com/65535/50403951781_ba272345ab_z.jpg"&#10;width="800" height="600"&#10;alt="Inktober 2020"&gt;&#10;&lt;/a&gt;&lt;script async src="//embedr.flickr.com/assets/client-code.js" charset="utf-8"&gt;&lt;/script&gt;&#10;&lt;p&gt;Short code defined like this&lt;/p&gt;&#10;&lt;div class="code-block"&gt;&#10; &lt;button class="code-copy" type="button" hidden aria-label="Copy code to clipboard"&gt;&#10; &lt;span class="code-copy-label" aria-hidden="true"&gt;Copy&lt;/span&gt;&#10; &lt;/button&gt;&#10; &lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-html" data-lang="html"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&amp;lt;&lt;span style="color:#f92672"&gt;a&lt;/span&gt; &lt;span style="color:#a6e22e"&gt;data-flickr-embed&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;true&amp;#34;&lt;/span&gt; &lt;span style="color:#a6e22e"&gt;data-header&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;true&amp;#34;&lt;/span&gt; &lt;span style="color:#a6e22e"&gt;data-footer&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;true&amp;#34;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#a6e22e"&gt;href&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;{{ index .Params 1 }}&amp;#34;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#a6e22e"&gt;title&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;{{ index .Params 0 }}&amp;#34;&lt;/span&gt;&amp;gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&amp;lt;&lt;span style="color:#f92672"&gt;img&lt;/span&gt; &lt;span style="color:#a6e22e"&gt;src&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;{{ index .Params 2 }}&amp;#34;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#a6e22e"&gt;width&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;800&amp;#34;&lt;/span&gt; &lt;span style="color:#a6e22e"&gt;height&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;600&amp;#34;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#a6e22e"&gt;alt&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;{{ index .Params 0 }}&amp;#34;&lt;/span&gt;&amp;gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&amp;lt;/&lt;span style="color:#f92672"&gt;a&lt;/span&gt;&amp;gt;&amp;lt;&lt;span style="color:#f92672"&gt;script&lt;/span&gt; &lt;span style="color:#a6e22e"&gt;async&lt;/span&gt; &lt;span style="color:#a6e22e"&gt;src&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;//embedr.flickr.com/assets/client-code.js&amp;#34;&lt;/span&gt; &lt;span style="color:#a6e22e"&gt;charset&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;utf-8&amp;#34;&lt;/span&gt;&amp;gt;&amp;lt;/&lt;span style="color:#f92672"&gt;script&lt;/span&gt;&amp;gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&#10; &lt;/div&gt;&lt;p&gt;First parameter is the album title.&#10;Second parameter is the album URL.&#10;Third parameter is a URL to an image to use for the album.&lt;/p&gt;</description></item><item><title>Hornsea 2020</title><link>https://blog.0x32.co.uk/posts/hornsea/</link><pubDate>Tue, 22 Sep 2020 11:03:37 +0100</pubDate><guid>https://blog.0x32.co.uk/posts/hornsea/</guid><description>&lt;p&gt;Photos from recent trip to Hornsea.&lt;/p&gt;&#10;&lt;figure class="wp-caption alignnone"&gt;